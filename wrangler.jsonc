{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agent-send",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/mcp",
      "/mcp/*",
      "/authorize",
      "/oauth/*",
      "/register",
      "/.well-known/*",
      "/connect"
    ]
  },
  "durable_objects": {
    "bindings": [{ "name": "HUB", "class_name": "Hub" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Hub"] }],
  "kv_namespaces": [{ "binding": "OAUTH_KV" }],
  "ratelimits": [
    { "name": "RL_PUBLIC", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
    { "name": "RL_AGENT", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } }
  ],
  "vars": {
    "UPSTREAM_REPO": "iamomiid/agent-send"
  }
}
